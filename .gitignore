# =========================
# Python / tooling
# =========================
__pycache__/
*.py[cod]
*.pyd
*.log

# Virtual envs / secrets
.env
.venv/
venv/
.env.*

# Packaging / build
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/
*.whl

# Common dev tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Jupyter / notebooks (if ever used)
.ipynb_checkpoints/

# IDE / editor
.vscode/
.idea/

# OS junk
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
Desktop.ini

# =========================
# Runtime / temp outputs (NEVER commit)
# =========================
_tmp_audio/
tmp_audio/
concat_*.txt
silence_*.wav
silence_*.mp3
temp_*.mp3
temp_*.wav
*.tmp
*.bak

# Optional: local crash dumps
*.stackdump

# =========================
# Generated episode artifacts (usually not needed in repo)
# =========================
script_*.txt

# If you want to keep ONLY intro/outro in git, but ignore generated episodes:
episode_audio/*.mp3
!intro.mp3
!outro.mp3

# If you publish your podcast episodes via GitHub Pages and NEED mp3s committed,
# remove the two lines above (episode_audio/*.mp3 and the exceptions).

# =========================
# Generated marketing outputs (keep repo lean)
# =========================
social_clips/
social_card*.jpg
social_surge*.gif
viral_caption.txt
marketing.txt
marketing_pack.json
platform_pack.json
episode_metadata.json

# If you do NOT want the main mp4 committed:
social_clip.mp4
# If you ever want to commit it intentionally, run:
#   git add -f social_clip.mp4
